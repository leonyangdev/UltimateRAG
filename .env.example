# Aliyun Model Studio (Bailian) OpenAI-compatible endpoint
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
LLM_MODEL=qwen-plus

# Local Docker Compose defaults
DATABASE_URL=postgresql+asyncpg://ultimate_rag:ultimate_rag@localhost:5432/ultimate_rag
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ultimate_rag
MINIO_SECRET_KEY=ultimate_rag_dev_secret
MINIO_SECURE=false
MINIO_BUCKET=documents
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowledge_chunks
CORS_ORIGINS=http://localhost:3000,http://192.168.3.19:3000
# 可选。留空时浏览器自动使用当前页面主机的 8000 端口；独立 API 域名部署时再填写。
NEXT_PUBLIC_API_URL=
